<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_purchase_scheduler_block" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.scheduler.block</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='group_warning_purchase']/../.." position="after">
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="purchase_scheduler_block_days_limit"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="purchase_scheduler_block_days_limit"/>
                        <div class="text-muted">
                            Días hacia atrás para validar órdenes de compra pendientes. 
                            Solo se validarán PO creadas después de esta fecha límite (hora 00:00:00).
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

